# ROMs, saves, boot ROMs, flash images: never commit (see CLAUDE.md hard rules)
*.gb
*.gbc
*.sav
*.uf2
*.bin
*.elf
*.map
*.dis
*.hex
bootrom*
dmg_boot*

# Build output
build/
build-host/

# Downloaded test ROMs
tests/roms/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
build-*/

# Synthetic golden files for the tests (our own bytes, no ROM data)
!tests/golden/*.bin

# Local ROM folders: never commit game files
roms/

# Screenshots of commercial games taken during compatibility checks: local only, never committed
compat-shots/
